{
  "name": "@palurn/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*",
    "#lib/*": "./src/lib/*",
    "#hooks/*": "./src/hooks/*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lato": "^5.3.0",
    "@palurn/api": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "react-day-picker": "^10.0.2",
    "react-router": "catalog:",
    "tailwind-merge": "^3.7.0"
  }
}
