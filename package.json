{
  "name": "palurn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:landing": "pnpm --filter @palurn/landing dev",
    "dev:company": "pnpm --filter @palurn/company dev",
    "dev:employee": "pnpm --filter @palurn/employee dev",
    "dev:admin": "pnpm --filter @palurn/admin dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
